# Copy to .vscode.env and fill in local values. Do not commit .vscode.env.
# init-project reads the setup metadata immediately above each assignment.
# Example defaults are used when setup cannot resolve a value.

# setup:
#   source: infer
#   infer: Use the effective dev internal_databricks_resource_id bundle variable.
#   fallback: example
AZURE_WORKSPACE_RESOURCE_ID=/subscriptions/1de5fd2d-2313-461a-acc4-07cdc509cdf4/resourceGroups/lake-cac-npd-rg-devplatform/providers/Microsoft.Databricks/workspaces/lake-cac-npd-dbw-devuc01

# setup:
#   source: infer
#   infer: From the effective dev internal_databricks_workspace_url hostname, extract the numeric ID only when the hostname matches adb-<digits>.<suffix>.azuredatabricks.net. Otherwise the value is unresolved.
#   fallback: example
DATABRICKS_WORKSPACE_ID=1700301391505163

# setup:
#   source: infer
#   infer: Use the hostname from effective dev internal_databricks_workspace_url, without its scheme or trailing slash.
#   fallback: example
DATABRICKS_HOST=adb-1700301391505163.3.azuredatabricks.net

# setup:
#   source: literal
#   value: dev
#   fallback: example
ENV_NAME=dev

# setup:
#   source: infer
#   infer: Use the effective dev value of the bundle variable selected through app_sql_warehouse during App Setup.
#   fallback: example
DATABRICKS_WAREHOUSE_ID=b3c9f78bbe356dd9

# setup:
#   source: infer
#   infer: Use the fully resolved effective dev catalog bundle variable.
#   fallback: example
UC_CATALOG_NAME=dev_application_cat

# setup:
#   source: preserve_example
#   description: Secret bindings contain key names, not credential values; do not infer or retrieve credentials.
#   fallback: example
SPN_TENANTID=

# setup:
#   source: preserve_example
#   description: Secret bindings contain key names, not credential values; do not infer or retrieve credentials.
#   fallback: example
SPN_ID=

# setup:
#   source: preserve_example
#   description: Secret bindings contain key names, not credential values; do not infer or retrieve credentials.
#   fallback: example
SPN_SECRET=

# setup:
#   source: infer
#   infer: Use a concrete positive integer already available for the selected app_job_access job binding. With no selected job or an unresolved resource reference, the value is unresolved. Do not query deployed jobs.
#   fallback: example
JOB_ID=
